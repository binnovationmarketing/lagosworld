{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/refund-policy", "destination": "/refund-policy/index.html" },
    { "source": "/service-policy", "destination": "/service-policy/index.html" },
    { "source": "/accessibility", "destination": "/accessibility/index.html" },
    { "source": "/california-notice", "destination": "/california-notice/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/jewelry", "destination": "/jewelry/index.html" },
    { "source": "/jewelry/privacy", "destination": "/jewelry/privacy/index.html" },
    { "source": "/jewelry/terms", "destination": "/jewelry/terms/index.html" },
    { "source": "/jewelry/shipping", "destination": "/jewelry/shipping/index.html" },
    { "source": "/jewelry/returns", "destination": "/jewelry/returns/index.html" },
    { "source": "/jewelry/faq", "destination": "/jewelry/faq/index.html" },
    { "source": "/cleaning", "destination": "/cleaning/index.html" },
    { "source": "/airbnb", "destination": "/airbnb/index.html" },
    { "source": "/calendar", "destination": "/calendar/index.html" },
    { "source": "/courses", "destination": "/jewelry/index.html" },
    { "source": "/powerwashing", "destination": "/powerwashing/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/emails", "schedule": "0 13 * * *" },
    { "path": "/api/cron/abandoned-carts", "schedule": "0 17 * * *" },
    { "path": "/api/cron/sync-catalog", "schedule": "0 9 * * 1" }
  ]
}
