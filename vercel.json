{
  "version": 2,
  "buildCommand": "npm install --production --ignore-scripts",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/jewelry", "destination": "/jewelry/index.html" },
    { "source": "/cleaning", "destination": "/cleaning/index.html" },
    { "source": "/courses", "destination": "/courses/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/emails", "schedule": "0 13 * * *" }
  ]
}
