{
  "buildCommand": "npm install",
  "framework": "express",
  "public": "public",
  "functions": {
    "api.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_KEY": "@supabase_key",
    "EMAIL_USER": "@email_user",
    "EMAIL_PASS": "@email_pass",
    "ADMIN_EMAIL": "@admin_email"
  }
}